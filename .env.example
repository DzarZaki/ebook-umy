APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Setel "true" pada server produksi ber-HTTPS supaya cookie sesi hanya
# dikirim lewat koneksi terenkripsi. Biarkan "false" selama lokal masih HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PENTING: verifikasi email kini menegakkan akses mahasiswa — pendaftar baru
# harus membuka tautan dari surel sebelum bisa masuk katalog. Di produksi,
# mailer wajib diganti SMTP yang benar-benar mengirim; nilai `log` di sini
# hanya menulis surel ke berkas log untuk pengembangan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HANYA UNTUK DEVELOPMENT — password akun seed. Jangan diisi di production.
SEED_PASSWORD=password

# ---------------------------------------------------------------------------
# Proksi tepercaya (X-Forwarded-For / X-Forwarded-Proto)
# ---------------------------------------------------------------------------
# Bawaan '*' percaya semua proksi: cocok untuk Cloudflare Tunnel, tetapi
# membuat alamat klien bisa dipalsukan lewat header X-Forwarded-For, sehingga
# pembatas laju berbasis IP (pendaftaran, lupa sandi, login) dapat dihindari
# dengan memutar-putar header itu. Di produksi, ganti dengan CIDR proksi
# yang benar-benar berada di depan aplikasi, contoh:
#   TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
# Bisa berisi beberapa alamat, dipisah koma. Kosongkan untuk tidak memercayai
# proksi mana pun (hanya tepat bila aplikasi diakses langsung tanpa proksi).
TRUSTED_PROXIES=*

# ---------------------------------------------------------------------------
# Peralatan pengolah PDF
# ---------------------------------------------------------------------------
# qpdf dipakai untuk dua hal yang tidak bisa digantikan pustaka PHP murni:
# memotong rentang halaman pada buku bermode "unduh sebagian", dan menempelkan
# stempel identitas ke dalam berkas PDF.
#
# Biarkan bernilai "qpdf" bila programnya sudah ada di PATH — inilah keadaan
# di server Linux setelah `dnf install qpdf` atau `apt install qpdf`. Isi
# dengan jalur lengkap HANYA bila belum masuk PATH:
#
#   Linux/macOS : QPDF_BINARY=qpdf
#   Windows     : QPDF_BINARY="C:/Program Files/qpdf 12.3.2/bin/qpdf.exe"
#
# Pakai garis miring maju (/) walau di Windows, dan beri tanda kutip bila
# jalurnya mengandung spasi.
#
# Sesudah mengubah nilai di bawah, pastikan hasilnya dengan:
#   php artisan config:clear && php artisan ebook:periksa-qpdf
QPDF_BINARY=qpdf
QPDF_TIMEOUT=60

# true  : unduhan yang membutuhkan qpdf ditolak (503) bila qpdf tidak ada,
#         supaya tidak ada buku yang tersalur tanpa stempel tanpa disadari.
# false : unduhan berstempel diteruskan tanpa stempel dan dicatat sebagai
#         galat. Untuk masa darurat saja. Mode "unduh sebagian" tetap ditolak.
EBOOK_QPDF_WAJIB=true

# ---------------------------------------------------------------------------
# Berkas sementara
# ---------------------------------------------------------------------------
EBOOK_TEMP_DISK=local
EBOOK_TEMP_TTL=30
EBOOK_DOWNLOAD_PER_HOUR=20
EBOOK_READ_PER_MINUTE=30

# Penyaluran berkas untuk penampil di halaman baca.
# Dua nilai di bawah hanyalah penengah: kebijakan sebenarnya diatur per
# program studi dari dashboard dosen (kolom baca_stempel dan
# baca_ikuti_rentang pada tabel prodi). Nilai ini dipakai bila pembaca
# tidak terikat prodi mana pun.
EBOOK_BACA_STEMPEL=true
EBOOK_BACA_IKUTI_RENTANG=false
EBOOK_BACA_TTL=120

# ---------------------------------------------------------------------------
# Tempat sampah buku
# ---------------------------------------------------------------------------
# Masa tenggang sebelum buku terbuang dilenyapkan permanen oleh perintah
# ebook:bersihkan-buku, dalam hari. Beri angka yang cukup panjang untuk
# menutupi masa libur; kesalahan hapus jarang disadari pada hari yang sama.
EBOOK_TRASH_DAYS=30
