# Tipe MIME yang tidak dikenali Apache bawaan.
#
# Vite mengeluarkan worker pdf.js sebagai modul ES berekstensi .mjs. Apache
# tidak punya pemetaan untuk ekstensi itu, sehingga berkasnya terkirim tanpa
# tipe JavaScript — dan peramban menolak memuat modul semacam itu, dengan
# pesan "non-JavaScript MIME type". Satu baris di bawah ini menutup celahnya.
#
# .wasm ikut didaftarkan karena pdf.js 5 ke atas memuat modul WebAssembly
# untuk gambar JPEG2000; gejalanya persis sama dan hanya muncul pada buku
# tertentu, sehingga jauh lebih sulit dilacak.
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Meneruskan header Authorization ke PHP.
    #
    # Perhatikan kurung kurawal penutup pada %{HTTP:Authorization}: tanpa itu
    # Apache membaca nama variabel yang tidak pernah ditutup, dan pada
    # konfigurasi yang ketat seluruh berkas ini ditolak dengan 500 — galatnya
    # hanya tercatat di log Apache, tidak di log Laravel.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization]

    # Meneruskan header X-XSRF-Token ke PHP.
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token]

    # Membuang garis miring di akhir alamat bila bukan folder.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Meneruskan semua permintaan lain ke pengendali depan.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>